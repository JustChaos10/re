{
  "name": "@re/core",
  "version": "0.1.0",
  "description": "Core framework for Re Generative UI with Google Vertex AI Gemini integration",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "keywords": [
    "generative-ui",
    "ai",
    "gemini",
    "vertex-ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.9.1",
    "jsonrepair": "^3.13.1",
    "zod": "^4.1.13"
  }
}
