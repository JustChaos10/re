# Vertex AI Configuration
# Get these from your Google Cloud Console: https://console.cloud.google.com/
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# Path to your service account JSON file (this file should NOT be committed to git)
# Download from: Google Cloud Console > IAM & Admin > Service Accounts > Create Key (JSON)
VERTEX_SERVICE_ACCOUNT_PATH=./service.json

# API Server Configuration
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
